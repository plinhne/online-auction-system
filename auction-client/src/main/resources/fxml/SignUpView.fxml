<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>

<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="main-scroll-pane" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.SignUpController">
    <content>
        <VBox alignment="CENTER" style="-fx-background-color: #f8fafc;">
            <padding>
                <Insets bottom="30.0" top="30.0" />
            </padding>
            <children>
                <VBox maxWidth="400.0" minWidth="400.0" styleClass="card" VBox.vgrow="NEVER">
                    <padding>
                        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
                    </padding>
                    <children>
                        <VBox alignment="CENTER" spacing="8.0">
                            <children>
                                <StackPane>
                                    <Circle fill="#2563eb" radius="22.0" />
                                    <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                                        <image>
                                            <Image url="@../icons/BidIcon.png" />
                                        </image>
                                    </ImageView>
                                </StackPane>
                                <Label styleClass="label, header" text="Create Account" />
                                <Label styleClass="label, subtitle" text="Join our auction platform today" />
                            </children>
                        </VBox>

                        <Separator prefWidth="200.0">
                            <VBox.margin>
                                <Insets bottom="15.0" top="12.0" />
                            </VBox.margin>
                        </Separator>

                        <VBox spacing="12.0">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <HBox spacing="3.0">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Full Name" />
                                                <Label style="-fx-text-fill: #ef4444;" text="*" />
                                            </children>
                                        </HBox>
                                        <TextField fx:id="txtFullName" prefHeight="38.0" promptText="John Doe" styleClass="text-field" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <HBox spacing="3.0">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Username" />
                                                <Label style="-fx-text-fill: #ef4444;" text="*" />
                                            </children>
                                        </HBox>
                                        <TextField fx:id="txtUsername" prefHeight="38.0" promptText="johndoe" styleClass="text-field" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <HBox spacing="3.0">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Email" />
                                                <Label style="-fx-text-fill: #ef4444;" text="*" />
                                            </children>
                                        </HBox>
                                        <TextField fx:id="txtEmail" prefHeight="38.0" promptText="john@example.com" styleClass="text-field" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <HBox spacing="3.0">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Account Type" />
                                                <Label style="-fx-text-fill: #ef4444;" text="*" />
                                            </children>
                                        </HBox>
                                        <ComboBox fx:id="cbAccountType" maxWidth="Infinity" prefHeight="38.0" promptText="Bidder - Browse and bid on auctions" styleClass="combo-box" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <HBox spacing="3.0">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Password" />
                                                <Label style="-fx-text-fill: #ef4444;" text="*" />
                                            </children>
                                        </HBox>
                                        <PasswordField fx:id="txtPassword" prefHeight="38.0" promptText="••••••••" styleClass="password-field" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <HBox spacing="3.0">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Confirm Password" />
                                                <Label style="-fx-text-fill: #ef4444;" text="*" />
                                            </children>
                                        </HBox>
                                        <PasswordField fx:id="txtConfirmPassword" prefHeight="38.0" promptText="••••••••" styleClass="password-field" />
                                    </children>
                                </VBox>

                                <Button fx:id="btnSignUp" maxWidth="Infinity" prefHeight="40.0" styleClass="button, primary" text="Sign Up">
                                    <VBox.margin>
                                        <Insets top="10.0" />
                                    </VBox.margin>
                                </Button>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER" spacing="5.0">
                            <VBox.margin>
                                <Insets top="15.0" />
                            </VBox.margin>
                            <children>
                                <Label styleClass="text-muted" style="-fx-font-size: 13px;" text="Already have an account?" />
                                <Button fx:id="linkLogin" styleClass="button, link-button" text="Log in" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>