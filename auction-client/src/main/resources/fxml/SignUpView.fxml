<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="600.0" styleClass="bg-light" stylesheets="@../css/style.css" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.auction.client.controller.SignUpController">
    <center>
        <VBox alignment="CENTER" maxWidth="450.0" spacing="25.0">
            <children>
                <!-- Form Container -->
                <VBox alignment="TOP_CENTER" prefWidth="420.0" spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
                    </padding>
                    <children>
                        <Label styleClass="header" text="Create Account">
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Label>
                        <Label styleClass="subtitle" text="Join our auction platform today">
                            <VBox.margin>
                                <Insets bottom="10.0" top="-8.0" />
                            </VBox.margin>
                        </Label>

                        <!-- Trường Full Name -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox spacing="3.0">
                                    <children>
                                        <Label styleClass="form-label" text="Full Name" />
                                        <Label styleClass="text-danger" text="*" />
                                    </children>
                                </HBox>
                                <TextField fx:id="txtFullName" promptText="John Doe" styleClass="text-field" />
                            </children>
                        </VBox>

                        <!-- Trường Username -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox spacing="3.0">
                                    <children>
                                        <Label styleClass="form-label" text="Username" />
                                        <Label styleClass="text-danger" text="*" />
                                    </children>
                                </HBox>
                                <TextField fx:id="txtUsername" promptText="johndoe" styleClass="text-field" />
                            </children>
                        </VBox>

                        <!-- Trường Email -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox spacing="3.0">
                                    <children>
                                        <Label styleClass="form-label" text="Email" />
                                        <Label styleClass="text-danger" text="*" />
                                    </children>
                                </HBox>
                                <TextField fx:id="txtEmail" promptText="john@example.com" styleClass="text-field" />
                            </children>
                        </VBox>

                        <!-- Trường Account Type -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox spacing="3.0">
                                    <children>
                                        <Label styleClass="form-label" text="Account Type" />
                                        <Label styleClass="text-danger" text="*" />
                                    </children>
                                </HBox>
                                <ComboBox fx:id="cbAccountType" maxWidth="1.7976931348623157E308" promptText="Bidder - Browse and bid on auctions" styleClass="combo-box" />
                            </children>
                        </VBox>

                        <!-- Trường Password -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox spacing="3.0">
                                    <children>
                                        <Label styleClass="form-label" text="Password" />
                                        <Label styleClass="text-danger" text="*" />
                                    </children>
                                </HBox>
                                <PasswordField fx:id="txtPassword" promptText="••••••••" styleClass="password-field" />
                            </children>
                        </VBox>

                        <!-- Trường Confirm Password -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox spacing="3.0">
                                    <children>
                                        <Label styleClass="form-label" text="Confirm Password" />
                                        <Label styleClass="text-danger" text="*" />
                                    </children>
                                </HBox>
                                <PasswordField fx:id="txtConfirmPassword" promptText="••••••••" styleClass="password-field" />
                            </children>
                        </VBox>

                        <!-- Nút Sign Up -->
                        <Button fx:id="btnSignUp" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="button-submit" text="Sign Up">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Button>

                        <!-- Chuyển sang Đăng nhập -->
                        <HBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label styleClass="text-muted" text="Already have an account?" />
                                <Hyperlink fx:id="linkLogin" styleClass="text-primary" text="Log in" />
                            </children>
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
