<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="600.0" styleClass="bg-light" stylesheets="@../css/style.css" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.auction.client.controller.LoginController">
   <center>
      <VBox alignment="CENTER" maxWidth="450.0" spacing="25.0">
         <children>
            <!-- Logo & Title Section -->
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label style="-fx-font-size: 56;" text="🔨" />
                  <Label styleClass="label, header" style="-fx-font-size: 36;" text="Auction Pro" />
                  <Label styleClass="label, subtitle" text="Hệ thống đấu giá trực tuyến thế hệ mới" />
               </children>
            </VBox>

            <!-- Main Login Form (Card) -->
            <VBox spacing="20.0" styleClass="card">
               <padding>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
               </padding>
               <children>
                  <!-- Username -->
                  <VBox spacing="8.0">
                     <children>
                        <Label style="-fx-font-weight: bold;" text="Tên đăng nhập" />
                        <TextField fx:id="usernameField" prefHeight="45.0" promptText="Nhập tài khoản..." styleClass="text-field" />
                     </children>
                  </VBox>

                  <!-- Password -->
                  <VBox spacing="8.0">
                     <children>
                        <Label style="-fx-font-weight: bold;" text="Mật khẩu" />
                        <PasswordField fx:id="passwordField" prefHeight="45.0" promptText="Nhập mật khẩu..." styleClass="password-field" />
                     </children>
                  </VBox>

                  <Label fx:id="errorLabel" styleClass="label, error" text="" />

                  <Button fx:id="loginButton" maxWidth="Infinity" prefHeight="45.0" styleClass="button, primary" text="Đăng Nhập" />
               </children>
            </VBox>

            <!-- Demo Access Section -->
            <VBox alignment="CENTER" spacing="15.0">
               <children>
                  <Label styleClass="text-muted" style="-fx-font-size: 11;" text="HOẶC TRUY CẬP NHANH BẰNG TÀI KHOẢN DEMO" />
                  <HBox spacing="10.0">
                     <children>
                        <Button fx:id="bidderDemoButton" styleClass="button, success" text="Người mua" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Button fx:id="sellerDemoButton" style="-fx-background-color: #f59e0b; -fx-text-fill: white;" styleClass="button" text="Người bán" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Button fx:id="adminDemoButton" styleClass="button, danger" text="Quản trị" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
