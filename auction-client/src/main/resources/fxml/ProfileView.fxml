<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="bg-light" stylesheets="@../css/style.css" xmlns="http://javafx.com" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.ProfileController">
   <center>
      <VBox spacing="25.0" maxWidth="600.0">
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
         <children>
            <!-- Back Button -->
            <Button styleClass="button" text="← Quay lại" />

            <!-- Profile Card -->
            <VBox spacing="25.0" styleClass="card">
               <padding>
                  <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
               </padding>
               <children>
                  <!-- Title -->
                  <Label styleClass="label, header" text="Hồ sơ cá nhân" />

                  <!-- User Avatar and Name -->
                  <HBox alignment="CENTER_LEFT" spacing="20.0">
                     <children>
                        <Circle radius="45.0" styleClass="bg-primary" />
                        <VBox spacing="5.0">
                           <children>
                              <Label fx:id="fullNameLabel" styleClass="label" style="-fx-font-size: 22; -fx-font-weight: bold;" text="Nguyễn Văn A" />
                              <Label fx:id="roleBadge" styleClass="bg-success" style="-fx-text-fill: white; -fx-padding: 2 12; -fx-background-radius: 15; -fx-font-size: 10;" text="NGƯỜI MUA" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <Separator />

                  <!-- User Information Grid -->
                  <VBox spacing="15.0">
                     <children>
                        <!-- Username -->
                        <HBox spacing="15.0" styleClass="bg-light" style="-fx-padding: 15; -fx-background-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 20;" text="👤" />
                              <VBox spacing="3.0">
                                 <children>
                                    <Label styleClass="text-muted" style="-fx-font-size: 11;" text="Tên đăng nhập" />
                                    <Label fx:id="usernameLabel" styleClass="label" style="-fx-font-weight: bold;" text="nguyenvana123" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <!-- Email -->
                        <HBox spacing="15.0" styleClass="bg-light" style="-fx-padding: 15; -fx-background-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 20;" text="📧" />
                              <VBox spacing="3.0">
                                 <children>
                                    <Label styleClass="text-muted" style="-fx-font-size: 11;" text="Địa chỉ Email" />
                                    <Label fx:id="emailLabel" styleClass="label" style="-fx-font-weight: bold;" text="vana@example.com" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <!-- ID Account -->
                        <HBox spacing="15.0" styleClass="bg-light" style="-fx-padding: 15; -fx-background-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 20;" text="🆔" />
                              <VBox spacing="3.0">
                                 <children>
                                    <Label styleClass="text-muted" style="-fx-font-size: 11;" text="Mã tài khoản" />
                                    <Label fx:id="accountIdLabel" styleClass="label" style="-fx-font-family: 'Courier New'; -fx-font-weight: bold;" text="USR-9981-XP" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <Separator />

                  <!-- Action Buttons -->
                  <HBox spacing="10.0" alignment="CENTER_RIGHT">
                     <children>
                        <Button styleClass="button" text="Chỉnh sửa hồ sơ" />
                        <Button styleClass="button, primary" text="Đổi mật khẩu" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
