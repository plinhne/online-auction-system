<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="bg-light" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.ProductDetailsController">
   <top>
      <HBox alignment="CENTER_LEFT" style="-fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;" styleClass="bg-white">
         <padding>
            <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
         </padding>
         <children>
            <Button fx:id="backButton" styleClass="button" text="← Quay lại danh sách" />
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" styleClass="scroll-pane">
         <content>
            <HBox spacing="30.0">
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>
               <children>
                  <VBox prefWidth="450.0" spacing="20.0">
                     <children>
                        <StackPane style="-fx-padding: 10;" styleClass="card">
                           <children>
                              <ImageView fx:id="productImage" fitHeight="400.0" fitWidth="430.0" preserveRatio="true" />
                           </children>
                        </StackPane>

                        <VBox spacing="15.0" styleClass="card">
                           <children>
                              <Label style="-fx-font-weight: bold;" styleClass="label" text="Thời gian đấu giá" />
                              <GridPane hgap="10.0" vgap="10.0">
                                 <columnConstraints>
                                    <ColumnConstraints minWidth="100" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                 </columnConstraints>
                                 <children>
                                    <Label styleClass="text-muted" text="Bắt đầu:" GridPane.rowIndex="0" />
                                    <Label fx:id="startTimeLabel" style="-fx-font-weight: bold;" text="2024-01-01 10:00" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Label styleClass="text-muted" text="Kết thúc:" GridPane.rowIndex="1" />
                                    <Label fx:id="endTimeLabel" style="-fx-font-weight: bold;" styleClass="text-danger" text="2024-01-08 10:00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                 </children>
                                 <rowConstraints>
                                    <RowConstraints />
                                    <RowConstraints />
                                 </rowConstraints>
                              </GridPane>
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="10.0">
                           <children>
                              <Label fx:id="productNameLabel" style="-fx-font-size: 32;" styleClass="label, header" text="Tên sản phẩm cao cấp" />
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label fx:id="categoryLabel" style="-fx-padding: 4 12; -fx-background-radius: 20; -fx-border-color: #ddd; -fx-border-radius: 20;" styleClass="bg-light" text="Điện tử" />
                                    <Label fx:id="statusLabel" style="-fx-font-weight: bold;" styleClass="text-success" text="● ĐANG DIỄN RA" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <VBox spacing="20.0" style="-fx-background-color: white;" styleClass="card">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <VBox spacing="5.0">
                                       <children>
                                          <Label styleClass="text-muted" text="Giá thầu hiện tại" />
                                          <Label fx:id="currentPriceLabel" style="-fx-font-size: 36; -fx-font-weight: bold;" styleClass="text-success" text="1.500.000đ" />
                                       </children>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <VBox alignment="TOP_RIGHT" spacing="5.0">
                                       <children>
                                          <Label styleClass="text-muted" text="Giá khởi điểm" />
                                          <Label fx:id="startingPriceLabel" style="-fx-font-weight: bold;" text="1.000.000đ" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>

                              <Separator />

                              <VBox spacing="10.0">
                                 <children>
                                    <Label fx:id="currentLeaderLabel" style="-fx-font-weight: bold;" styleClass="text-primary" text="🏆 Người dẫn đầu: Nguyễn Văn A" />
                                    <HBox spacing="10.0">
                                       <children>
                                          <Button fx:id="placeBidButton" prefHeight="45.0" prefWidth="150.0" styleClass="button, primary" text="ĐẶT GIÁ NGAY" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>

                        <VBox spacing="10.0" styleClass="card">
                           <children>
                              <Label style="-fx-font-weight: bold;" styleClass="label" text="Mô tả sản phẩm" />
                              <Label fx:id="descriptionArea" styleClass="label, subtitle" text="Đây là mô tả chi tiết về sản phẩm..." wrapText="true" />
                           </children>
                        </VBox>

                        <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label style="-fx-font-weight: bold;" styleClass="label" text="Lịch sử đấu giá" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="bidCountLabel" styleClass="text-muted" text="0 lượt đặt" />
                                 </children>
                              </HBox>
                              <TableView fx:id="bidsTable" prefHeight="200.0" styleClass="table-view">
                                 <columns>
                                    <TableColumn fx:id="bidderColumn" prefWidth="150.0" text="Người đặt" />
                                    <TableColumn fx:id="amountColumn" prefWidth="150.0" text="Số tiền" />
                                    <TableColumn fx:id="timeColumn" prefWidth="200.0" text="Thời gian" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
