<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controller.PaginationController"
      alignment="CENTER" spacing="15"
      styleClass="pagination-container">

    <Button fx:id="prevBtn" text="&lt; Trước" onAction="#handlePrev" styleClass="pagination-btn"/>
    <Label fx:id="pageInfo" text="Trang 1 / 1" styleClass="pagination-label" />
    <Button fx:id="nextBtn" text="Sau &gt;" onAction="#handleNext" styleClass="pagination-btn"/>

</HBox>