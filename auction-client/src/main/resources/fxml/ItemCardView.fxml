<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="350.0" prefWidth="250.0" style="-fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-color: white;" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.auction.client.controller.ItemCardController">
   <top>
      <VBox prefHeight="200.0" style="-fx-background-color: #f3f4f6;">
         <children>
            <ImageView fx:id="productImage" fitHeight="160.0" fitWidth="250.0" pickOnBounds="true" />
            <HBox spacing="8.0" style="-fx-padding: 10;">
               <children>
                  <Label fx:id="statusBadge" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 4 12; -fx-border-radius: 4; -fx-font-size: 9; -fx-font-weight: bold;" text="RUNNING" />
                  <Label fx:id="categoryBadge" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 4; -fx-padding: 4 12; -fx-font-size: 9;" text="Electronics" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="timeRemainingBadge" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 4 8; -fx-border-radius: 4; -fx-font-size: 9; -fx-font-weight: bold;" text="3h 45m" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <VBox spacing="8.0" style="-fx-padding: 12;">
         <children>
            <Label fx:id="itemNameLabel" style="-fx-font-size: 12; -fx-font-weight: bold;" text="Item Name" wrapText="true" />
            <Label fx:id="descriptionLabel" style="-fx-font-size: 11; -fx-text-fill: #666666;" text="Description..." wrapText="true" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label style="-fx-font-size: 11; -fx-text-fill: #666666;" text="Current Bid" />
                  <Label fx:id="currentPriceLabel" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #10b981;" text="\$0" />
               </children>
            </HBox>
            <Label fx:id="bidsLabel" style="-fx-font-size: 10; -fx-text-fill: #999999;" text="0 bids" />
         </children>
      </VBox>
   </center>

   <bottom>
      <VBox spacing="8.0" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0; -fx-padding: 10;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Label fx:id="viewsLabel" style="-fx-font-size: 10; -fx-text-fill: #999999;" text="0 views" />
                  <Label fx:id="currentLeaderLabel" style="-fx-font-size: 10; -fx-text-fill: #999999;" text="Leading: User" visible="false" />
               </children>
            </HBox>
            <Button fx:id="viewDetailsButton" maxWidth="500.0" prefHeight="35.0" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: bold; -fx-border-radius: 4;" text="View Details" />
         </children>
      </VBox>
   </bottom>
</BorderPane>