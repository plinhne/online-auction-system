<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="280.0" styleClass="card" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.ItemCardController">
   <top>
      <VBox styleClass="bg-light">
         <children>
            <!-- Ảnh sản phẩm với tỉ lệ cố định -->
            <StackPane prefHeight="160.0" style="-fx-background-color: #eee;">
               <children>
                  <ImageView fx:id="productImage" fitHeight="160.0" fitWidth="280.0" preserveRatio="true" />
               </children>
            </StackPane>

            <!-- Hệ thống Badge (Nhãn trạng thái) -->
            <HBox spacing="5.0">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Label fx:id="statusBadge" style="-fx-text-fill: white; -fx-padding: 2 8; -fx-background-radius: 4; -fx-font-size: 10; -fx-font-weight: bold;" styleClass="bg-success" text="ĐANG CHẠY" />
                  <Label fx:id="categoryBadge" style="-fx-border-color: #d1d5db; -fx-border-radius: 4; -fx-padding: 2 8; -fx-font-size: 10;" text="Điện tử" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="timeRemainingBadge" style="-fx-text-fill: white; -fx-padding: 2 8; -fx-background-radius: 4; -fx-font-size: 10; -fx-font-weight: bold;" styleClass="bg-danger" text="3h 45m" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <VBox spacing="8.0">
         <padding>
            <Insets bottom="15.0" left="12.0" right="12.0" top="5.0" />
         </padding>
         <children>
            <Label fx:id="itemNameLabel" style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="label" text="Tên sản phẩm" wrapText="true" />
            <Label fx:id="descriptionLabel" prefHeight="40.0" styleClass="label, subtitle" text="Mô tả ngắn gọn về sản phẩm đấu giá..." wrapText="true" />

            <HBox alignment="BOTTOM_LEFT" spacing="5.0">
               <children>
                  <VBox>
                     <children>
                        <Label style="-fx-font-size: 10;" styleClass="text-muted" text="Giá hiện tại" />
                        <Label fx:id="priceLabel" style="-fx-font-size: 18; -fx-font-weight: bold;" styleClass="text-success" text="1.500.000đ" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>

   <bottom>
      <VBox spacing="10.0" style="-fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="currentLeaderLabel" style="-fx-font-weight: bold; -fx-font-size: 10;" styleClass="text-primary" text="Bạn đang dẫn đầu" visible="false" />
               </children>
            </HBox>
            <Button fx:id="viewDetailsButton" maxWidth="Infinity" styleClass="button, primary" text="Xem chi tiết" />
         </children>
      </VBox>
   </bottom>
</BorderPane>
