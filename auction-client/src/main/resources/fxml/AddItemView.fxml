<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="bg-light" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21.0.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AddEditItemController">
   <center>
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" styleClass="bg-light">
         <content>
            <VBox spacing="20.0">
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>

               <HBox>
                  <Button styleClass="button" text="← Quay lại" />
               </HBox>

               <VBox spacing="20.0" styleClass="card">
                  <Label fx:id="titleLabel" styleClass="label, header" text="Thêm sản phẩm đấu giá mới" />

                  <VBox spacing="8.0">
                     <Label styleClass="label" style="-fx-font-weight: bold;" text="Tên sản phẩm *" />
                     <TextField fx:id="itemNameField" promptText="Nhập tên sản phẩm..." styleClass="text-field" />
                  </VBox>

                  <VBox spacing="8.0">
                     <Label styleClass="label" style="-fx-font-weight: bold;" text="Mô tả *" />
                     <TextArea fx:id="descriptionArea" prefHeight="100.0" promptText="Nhập mô tả chi tiết..." styleClass="text-area" wrapText="true" />
                  </VBox>

                  <VBox spacing="10.0">
                     <Label styleClass="label" style="-fx-font-weight: bold;" text="Hình ảnh sản phẩm" />
                     <HBox spacing="10.0">
                        <ImageView fx:id="imagePreview" fitHeight="150.0" fitWidth="200.0" preserveRatio="true" style="-fx-border-color: #e5e7eb; -fx-border-radius: 4;" />
                        <VBox spacing="10.0">
                           <Button fx:id="uploadImageButton" styleClass="button" text="Tải ảnh lên" />
                           <Button fx:id="removeImageButton" styleClass="button, danger" text="Xóa ảnh" visible="false" />
                        </VBox>
                     </HBox>
                  </VBox>

                  <HBox spacing="20.0">
                     <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="label" style="-fx-font-weight: bold;" text="Danh mục *" />
                        <ComboBox fx:id="categoryCombo" maxWidth="Infinity" styleClass="combo-box" />
                     </VBox>

                     <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="label" style="-fx-font-weight: bold;" text="Giá khởi điểm (USD) *" />
                        <TextField fx:id="startingPriceField" promptText="0.00" styleClass="text-field" />
                     </VBox>
                  </HBox>

                  <HBox spacing="20.0">
                     <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="label" style="-fx-font-weight: bold;" text="Ngày bắt đầu *" />
                        <HBox spacing="10.0">
                           <DatePicker fx:id="startDatePicker" HBox.hgrow="ALWAYS" />
                           <Spinner fx:id="startHourSpinner" prefWidth="100.0" />
                        </HBox>
                     </VBox>
                     <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="label" style="-fx-font-weight: bold;" text="Ngày kết thúc *" />
                        <HBox spacing="10.0">
                           <DatePicker fx:id="endDatePicker" HBox.hgrow="ALWAYS" />
                           <Spinner fx:id="endHourSpinner" prefWidth="100.0" />
                        </HBox>
                     </VBox>
                  </HBox>

                  <Label fx:id="errorLabel" styleClass="label, error" text="" />

                  <HBox spacing="15.0">
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                     <Button fx:id="saveButton" maxWidth="Infinity" prefHeight="40.0" styleClass="button, primary" text="Lưu sản phẩm" HBox.hgrow="ALWAYS" />
                     <Button fx:id="cancelButton" maxWidth="Infinity" prefHeight="40.0" styleClass="button" text="Hủy bỏ" HBox.hgrow="ALWAYS" />
                  </HBox>
               </VBox>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>