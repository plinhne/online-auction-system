<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="bg-light" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.SellerDashboardController">

   <!-- Header: Title & Add Action -->
   <top>
      <VBox styleClass="bg-white" style="-fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="label, header" text="Bảng điều khiển người bán" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="addItemButton" styleClass="button, primary" text="➕ Thêm sản phẩm mới" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <VBox spacing="20.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>

            <!-- Quick Stats Cards Area -->
            <HBox spacing="15.0">
               <children>
                  <!-- Card: Total Items -->
                  <VBox HBox.hgrow="ALWAYS" spacing="8.0" styleClass="card">
                     <children>
                        <Label styleClass="label, subtitle" text="Tổng sản phẩm" />
                        <Label fx:id="totalItemsLabel" styleClass="label, header" text="0" />
                     </children>
                  </VBox>

                  <!-- Card: Total Revenue -->
                  <VBox HBox.hgrow="ALWAYS" spacing="8.0" styleClass="card">
                     <children>
                        <Label styleClass="label, subtitle" text="Tổng doanh thu" />
                        <Label fx:id="totalRevenueLabel" styleClass="label, header, text-success" text="0đ" />
                     </children>
                  </VBox>

                  <!-- Card: Active Auctions -->
                  <VBox HBox.hgrow="ALWAYS" spacing="8.0" styleClass="card">
                     <children>
                        <Label styleClass="label, subtitle" text="Đang đấu giá" />
                        <Label fx:id="activeAuctionsLabel" styleClass="label, header, text-primary" text="0" />
                     </children>
                  </VBox>

                  <!-- Card: Total Bids -->
                  <VBox HBox.hgrow="ALWAYS" spacing="8.0" styleClass="card">
                     <children>
                        <Label styleClass="label, subtitle" text="Lượt trả giá" />
                        <Label fx:id="totalBidsLabel" styleClass="label, header" text="0" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Management Table Area -->
            <VBox spacing="15.0" styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="label" style="-fx-font-weight: bold; -fx-font-size: 16;" text="Danh sách sản phẩm của bạn" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="editButton" styleClass="button" text="📝 Chỉnh sửa" />
                              <Button fx:id="deleteButton" styleClass="button, danger" text="🗑 Xóa" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>

                  <TableView fx:id="itemsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Tên sản phẩm" />
                        <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Danh mục" />
                        <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Trạng thái" />
                        <TableColumn fx:id="priceColumn" prefWidth="130.0" text="Giá hiện tại" />
                        <TableColumn fx:id="bidsColumn" prefWidth="80.0" text="Lượt đặt" />
                        <TableColumn fx:id="endTimeColumn" prefWidth="180.0" text="Thời gian kết thúc" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
