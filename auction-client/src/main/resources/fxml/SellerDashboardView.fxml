<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #f9fafb;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.ui.controllers.SellerDashboardController">
   <top>
      <VBox style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-padding: 20;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label style="-fx-font-size: 28; -fx-font-weight: bold;" text="Seller Dashboard" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="addItemButton" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-size: 12; -fx-cursor: hand;" text="&#x2795; Add New Item" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <VBox spacing="20.0" style="-fx-padding: 20;">
         <children>
            <!-- Stats Cards dùng HBox để tránh lỗi GridPane Column -->
            <HBox spacing="15.0">
               <children>
                  <!-- Total Items -->
                  <VBox HBox.hgrow="ALWAYS" spacing="8.0" style="-fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 20; -fx-background-color: white;">
                     <children>
                        <Label style="-fx-font-size: 10; -fx-text-fill: #666666;" text="Total Items" />
                        <Label fx:id="totalItemsLabel" style="-fx-font-size: 28; -fx-font-weight: bold;" text="0" />
                     </children>
                  </VBox>
      
                  <!-- Total Revenue -->
                  <VBox HBox.hgrow="ALWAYS" spacing="8.0" style="-fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 20; -fx-background-color: white;">
                     <children>
                        <Label style="-fx-font-size: 10; -fx-text-fill: #666666;" text="Total Revenue" />
                        <Label fx:id="totalRevenueLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #10b981;" text="\$0.00" />
                     </children>
                  </VBox>
      
                  <!-- Active Auctions -->
                  <VBox HBox.hgrow="ALWAYS" spacing="8.0" style="-fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 20; -fx-background-color: white;">
                     <children>
                        <Label style="-fx-font-size: 10; -fx-text-fill: #666666;" text="Active Auctions" />
                        <Label fx:id="activeAuctionsLabel" style="-fx-font-size: 28; -fx-font-weight: bold;" text="0" />
                     </children>
                  </VBox>
      
                  <!-- Total Bids -->
                  <VBox HBox.hgrow="ALWAYS" spacing="8.0" style="-fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 20; -fx-background-color: white;">
                     <children>
                        <Label style="-fx-font-size: 10; -fx-text-fill: #666666;" text="Total Bids" />
                        <Label fx:id="totalBidsLabel" style="-fx-font-size: 28; -fx-font-weight: bold;" text="0" />
                     </children>
                  </VBox>
               </children>
            </HBox>
      
            <!-- Items Table -->
            <VBox spacing="10.0" style="-fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 20; -fx-background-color: white;" VBox.vgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Your Auction Items" />
      
                  <TableView fx:id="itemsTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Item Name" />
                        <TableColumn fx:id="categoryColumn" prefWidth="100.0" text="Category" />
                        <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status" />
                        <TableColumn fx:id="priceColumn" prefWidth="100.0" text="Price" />
                        <TableColumn fx:id="bidsColumn" prefWidth="60.0" text="Bids" />
                        <TableColumn fx:id="endTimeColumn" prefWidth="150.0" text="End Time" />
                     </columns>
                  </TableView>
      
                  <HBox spacing="10.0">
                     <children>
                        <Button fx:id="editButton" style="-fx-padding: 8 15; -fx-font-size: 11; -fx-cursor: hand;" text="&#x270f; Edit" />
                        <Button fx:id="deleteButton" style="-fx-padding: 8 15; -fx-font-size: 11; -fx-text-fill: #ef4444; -fx-cursor: hand;" text="&#x1f5d1; Delete" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>