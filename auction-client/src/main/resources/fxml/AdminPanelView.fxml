<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="bg-light" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AdminPanelController">

   <top>
      <VBox style="-fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;" styleClass="bg-white">
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         <children>
            <Label styleClass="label, header" text="Quản trị hệ thống (Admin)" />
         </children>
      </VBox>
   </top>

   <center>
      <VBox spacing="20.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>

            <HBox spacing="15.0">
               <children>
                  <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="label, subtitle" text="Tổng số đấu giá" />
                        <Label fx:id="totalAuctionsLabel" styleClass="label, header" text="0" />
                     </children>
                  </VBox>

                  <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="label, subtitle" text="Người dùng hệ thống" />
                        <Label fx:id="totalUsersLabel" styleClass="label, header" text="0" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
               <tabs>

                  <Tab text="Quản lý Đấu giá">
                     <content>
                        <VBox spacing="15.0" style="-fx-background-color: white;" styleClass="card">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 16;" styleClass="label" text="Danh sách cuộc đấu giá" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="approveAuctionButton" styleClass="button, success" text="✓ Duyệt Đấu Giá" />
                                    <Button fx:id="deleteAuctionButton" styleClass="button, danger" text="🗑 Xóa Đấu Giá" />
                                 </children>
                              </HBox>

                              <TableView fx:id="auctionsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="auctionIdColumn" prefWidth="70.0" text="ID" />
                                    <TableColumn fx:id="auctionNameColumn" prefWidth="250.0" text="Tên sản phẩm" />
                                    <TableColumn fx:id="sellerColumn" prefWidth="150.0" text="Người bán" />
                                    <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Trạng thái" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>
                     </content>
                  </Tab>

                  <Tab text="Quản lý Người dùng">
                     <content>
                        <VBox spacing="15.0" style="-fx-background-color: white;" styleClass="card">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 16;" styleClass="label" text="Danh sách thành viên" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="addUserButton" styleClass="button, primary" text="➕ Thêm" />
                                    <Button fx:id="editUserButton" styleClass="button" text="✏ Sửa" />
                                    <Button fx:id="changeBalanceButton" style="-fx-background-color: #16a34a; -fx-text-fill: white;" styleClass="button, success" text="💰 Sửa Số Dư" />
                                    <Button fx:id="deleteUserButton" styleClass="button, danger" text="🗑 Xóa" />
                                 </children>
                              </HBox>

                              <TableView fx:id="usersTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="userIdColumn" prefWidth="50.0" text="ID" />
                                    <TableColumn fx:id="usernameColumn" prefWidth="150.0" text="Tên tài khoản" />
                                    <TableColumn fx:id="emailColumn" prefWidth="180.0" text="Email" />
                                    <TableColumn fx:id="balanceColumn" prefWidth="120.0" text="Số dư" />
                                    <TableColumn fx:id="roleColumn" prefWidth="100.0" text="Vai trò" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>
                     </content>
                  </Tab>

               </tabs>
            </TabPane>

         </children>
      </VBox>
   </center>
</BorderPane>
