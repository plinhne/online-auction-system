<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.auction.client.controller.MainController">
    
    <top>
        <HBox style="-fx-background-color: #030213; -fx-padding: 10; -fx-spacing: 10;">
            <Label text="Auction System" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Profile"/>
            <Button text="Dashboard"/>
            <Button text="Logout"/>
        </HBox>
    </top>
    
    <left>
        <VBox style="-fx-background-color: #f5f5f5; -fx-padding: 15; -fx-spacing: 10;" prefWidth="200">
            <Label text="Filters" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            <ComboBox fx:id="categoryFilterCombo" promptText="Select Category"/>
            <TextField fx:id="searchField" promptText="Search auctions..."/>
        </VBox>
    </left>
    
    <center>
        <ScrollPane>
            <GridPane fx:id="auctionGridPane" style="-fx-padding: 15;" hgap="15" vgap="15"/>
        </ScrollPane>
    </center>
</BorderPane>