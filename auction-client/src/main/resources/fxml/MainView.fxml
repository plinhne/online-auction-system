<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox prefHeight="800.0" prefWidth="1200.0" stylesheets="@../css/style.css" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.auction.client.controller.MainController">
    <children>

        <!-- THANH NAVBAR TRÊN CÙNG -->
        <HBox alignment="CENTER_LEFT" minHeight="70.0" prefHeight="70.0" spacing="20.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="24.0" right="24.0" />
            </padding>
            <children>

                <!-- BLOCK 1: BRAND LOGO & TITLE -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS">
                    <children>
                        <!-- Vòng tròn chứa Icon Búa Đấu Giá -->
                        <HBox alignment="CENTER" maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0" style="-fx-background-color: #1a66ff; -fx-background-radius: 50%;">
                            <children>
                                <SVGPath content="M17.41 5.93l-3.34-3.34c-.78-.78-2.05-.78-2.83 0L3.11 10.72c-.78.78-.78 2.05 0 2.83l3.34 3.34c.78.78 2.05.78 2.83 0l8.13-8.13c.78-.78.78-2.05 0-2.83zM2 21h7v2H2z" fill="WHITE" scaleX="0.8" scaleY="0.8" />
                            </children>
                        </HBox>
                        <!-- Tiêu đề và Slogan -->
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                            <children>
                                <Label style="-fx-font-family: 'Segoe UI', Arial; -fx-font-size: 18.0; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Auction House" />
                                <Label style="-fx-font-family: 'Segoe UI', Arial; -fx-font-size: 11.0; -fx-text-fill: #64748b;" text="Live Bidding Platform" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- BLOCK 2: NAVIGATION BUTTONS & AVATAR CLICKABLE -->
                <HBox alignment="CENTER_RIGHT" spacing="24.0">
                    <children>
                        <!-- Nút Auctions -->
                        <Button fx:id="auctionsButton" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-family: 'Segoe UI'; -fx-font-size: 14.0; -fx-font-weight: 500; -fx-text-fill: #334155;" text="Auctions" />
                        <!-- Nút Dashboard -->
                        <Button fx:id="dashboardButton" graphicTextGap="8.0" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-family: 'Segoe UI'; -fx-font-size: 14.0; -fx-font-weight: 500; -fx-text-fill: #334155;" text="Dashboard">
                            <graphic>
                                <SVGPath content="M4 4h4v4H4zm6 0h4v4h-4zM4 10h4v4H4zm6 0h4v4h-4z" fill="#64748b" scaleX="1.0" scaleY="1.0" />
                            </graphic>
                        </Button>
                        <!-- AVATAR ĐƯỢC CHUYỂN THÀNH STACKPANE CÓ FX:ID ĐỂ BẮT SỰ KIỆN CLICK -->
                        <StackPane fx:id="avatarButton" maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0" style="-fx-background-color: #1a66ff; -fx-background-radius: 50%; -fx-cursor: hand;">
                            <children>
                                <Label style="-fx-font-family: 'Segoe UI', Arial; -fx-font-size: 16.0; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="J" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>

            </children>
        </HBox>

        <!-- VÙNG KHÔNG GIAN DƯỚI THANH NAVBAR DÙNG ĐỂ LOAD LIST VIEW -->
        <VBox fx:id="contentArea" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <!-- Bạn có thể nhúng trực tiếp <ListView> vào đây hoặc dùng code Java để inject dữ liệu động vào 'contentArea' -->
        </VBox>

    </children>
</VBox>
